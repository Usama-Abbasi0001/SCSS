rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to get current user's UID
    function requesterUid() {
      return request.auth.uid;
    }

    // 1. Users Collection: Users can read/write their own document; Admins can manage all
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 2. User Status (Online/Offline Presence)
    match /userStatus/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 3. Students Collection: Read & write access for authenticated users
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. Parents Collection
    match /parents/{parentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 5. Devices (ESP32 IoT Tracking Hardware)
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 6. Current Locations
    match /locations/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 7. Location History (GPS Breadcrumbs)
    match /locationHistory/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 8. Alerts & SOS Alarms
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /sosAlerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 9. Notifications Queue
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 10. System Configuration & Seed State
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
