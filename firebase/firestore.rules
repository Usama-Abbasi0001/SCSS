rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function requesterUid() {
      return request.auth.uid;
    }

    function requesterUserPath() {
      return /databases/$(database)/documents/users/$(requesterUid());
    }

    function requesterProfileExists() {
      return isSignedIn() && exists(requesterUserPath());
    }

    function requesterRole() {
      return requesterProfileExists()
        ? get(requesterUserPath()).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && requesterRole() == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && requesterUid() == uid;
    }

    match /users/{userId} {
      // Admin: full CRUD on all users.
      // Non-admin: read own profile so login/profile fetch works.
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
      allow update, delete: if isAdmin();
    }

    match /userStatus/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isOwner(uid) || isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow write: if isAdmin() || isOwner(studentId);
    }

    match /parents/{parentId} {
      allow read: if isAdmin() || isOwner(parentId);
      allow write: if isAdmin() || isOwner(parentId);
    }

    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
