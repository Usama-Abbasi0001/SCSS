rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getAuthUid() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'admin') ||
        (request.auth.token.role == 'admin') ||
        (request.auth.token.email == 'admin@smartcampus.local') ||
        (request.auth.token.email == 'admin@smartcampus.com')
      );
    }

    function isStudent() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'student') ||
        (request.auth.token.role == 'student')
      );
    }

    function isParent() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'parent') ||
        (request.auth.token.role == 'parent')
      );
    }

    function isLinkedParent(studentId) {
      return isParent() && (
        (exists(/databases/$(database)/documents/parents/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentId == studentId ||
          get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentId == studentId ||
          (get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.children != null &&
           studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.children)
        )) ||
        (exists(/databases/$(database)/documents/students/$(studentId)) && (
          get(/databases/$(database)/documents/students/$(studentId)).data.parentId == request.auth.uid ||
          get(/databases/$(database)/documents/students/$(studentId)).data.parentUid == request.auth.uid
        ))
      );
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. USER STATUS (Presence & Heartbeat)
    // ==========================================
    match /userStatus/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ==========================================
    // 3. STUDENTS COLLECTION
    // ==========================================
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == studentId || 
        isParent() ||
        resource.data.parentId == request.auth.uid ||
        resource.data.parentUid == request.auth.uid
      );
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == studentId);
      allow update: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == studentId || 
        (isParent() && (resource.data.parentId == request.auth.uid || resource.data.parentUid == request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. PARENTS COLLECTION
    // ==========================================
    match /parents/{parentId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == parentId || isStudent());
      allow create, update: if isSignedIn() && (isAdmin() || request.auth.uid == parentId);
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. DEVICES (IoT Tracking Hardware)
    // ==========================================
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. CURRENT LOCATIONS
    // ==========================================
    match /locations/{studentId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == studentId || isParent());
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == studentId);
    }

    // ==========================================
    // 7. LOCATION HISTORY (GPS Breadcrumbs)
    // ==========================================
    match /locationHistory/{historyId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        isParent()
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.studentId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 8. ALERTS & SOS ALARMS
    // ==========================================
    match /alerts/{alertId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        resource.data.parentId == request.auth.uid || 
        isParent()
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        resource.data.parentId == request.auth.uid || 
        isParent()
      );
      allow delete: if isAdmin();
    }

    match /sosAlerts/{alertId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        resource.data.parentId == request.auth.uid || 
        isParent()
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        resource.data.parentId == request.auth.uid || 
        isParent()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 9. NOTIFICATIONS QUEUE
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid || 
        resource.data.recipientId == 'admin' ||
        resource.data.recipientId == 'all'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. SYSTEM CONFIGURATION
    // ==========================================
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // 11. HARASSMENT INCIDENTS
    // ==========================================
    match /harassment_incidents/{incidentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid || 
        resource.data.parentId == request.auth.uid || 
        isParent() && resource.data.parentId == request.auth.uid // Redundant but explicit
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        (isStudent() && request.resource.data.studentId == request.auth.uid)
      );
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isAdmin();
    }
  }
}
